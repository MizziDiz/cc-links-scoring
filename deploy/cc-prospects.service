[Unit]
Description=Common Crawl prospect collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/cc-links-scoring
Environment=PYTHONUNBUFFERED=1
# --pattern-min-yield 0.2: do not pay a WARC request for URLs whose discovery
# pattern historically stores under 20% (46% of fetches on 25-30 July 2026 were
# unmatched; 97% of that sat in groups under this threshold). The profile is
# rebuilt from prospects.db before each crawl. --discovery-metrics keeps the
# per-part funnel counters the yield/pruning analysis depends on.
# --target-total must exceed what prospects.db already holds (1.95M candidates
# on 2026-07-30), otherwise multi_crawl exits at once without touching a crawl.
ExecStart=/opt/cc-links-scoring/.venv/bin/python /opt/cc-links-scoring/multi_crawl.py --target-total 3000000 --max-crawls 24 --discovery-shards 0 --state-dir /var/lib/cc-prospects/crawls-v3 --categories-file /opt/cc-links-scoring/categories.json --per-category-limit 5000 --max-parts 300 --max-per-domain 10 --min-score 50 --db /var/lib/cc-prospects/prospects.db --workers 16 --source s3 --progress-interval 60 --discovery-metrics --pattern-min-yield 0.2 --pattern-yield-since "2026-09-05 22:00" --per-run-domain-cap 3
# --pattern-yield-since must be the moment the CURRENT taxonomy went live
# (v3: 2026-09-05 22:00 UTC). Yield is keyed by pattern id, and a rule the new
# taxonomy fixed (guestbook: 4.5% under v2, 97% under v3) would otherwise be
# skipped on its old history. Move this date forward with every taxonomy change.
# Rescanning already-decided snapshots is deliberate after a taxonomy change:
# measured 2026-09-05 on CC-MAIN-2026-30 (fully scanned under v2 in July), the
# v3 rescan added >47k candidates on >36k new domains for ~55 minutes of one
# vCPU. Add --skip-crawls-in-db only when the taxonomy has not changed since
# the last pass; rejected pages can then be re-checked with recheck_unmatched.py.
# OOM kills and crashes are worth a restart; the fetch loop commits every 200
# results whatever their outcome, so a restart replays little. Not "always":
# multi_crawl exits 0 once the target is met and must then stay down.
Restart=on-failure
RestartSec=30
TimeoutStopSec=300
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
